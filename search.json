---
layout: null
---
[
  {%- assign first = true -%}
  {%- for post in site.posts -%}
    {%- unless first -%},{%- endunless -%}
    {"title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }}, "content": {{ post.content | strip_html | strip_newlines | truncate: 200 | jsonify }}}
    {%- assign first = false -%}
  {%- endfor -%}
  {%- for page in site.pages -%}
    {%- if page.title and page.url != "/404.html" -%}
      {%- unless first -%},{%- endunless -%}
      {"title": {{ page.title | jsonify }}, "url": {{ page.url | relative_url | jsonify }}, "content": {{ page.content | strip_html | strip_newlines | truncate: 200 | jsonify }}}
      {%- assign first = false -%}
    {%- endif -%}
  {%- endfor -%}
  {%- for prompt in site.prompts -%}
    {%- unless first -%},{%- endunless -%}
    {%- assign anchor = prompt.title | slugify -%}
    {%- assign prompt_link = '/prompt-library#' | append: anchor | relative_url -%}
    {"title": {{ prompt.title | jsonify }}, "url": {{ prompt_link | jsonify }}, "content": {{ prompt.content | strip_html | strip_newlines | truncate: 200 | jsonify }}}
    {%- assign first = false -%}
  {%- endfor -%}
]
